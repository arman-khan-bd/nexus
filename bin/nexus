#!/usr/bin/env php
<?php

declare(strict_types=1);

/**
 * Nexus CLI Executable (bin/nexus)
 * Next.js-inspired, JSX-compiled, ultra-secure PHP framework for cPanel.
 */

$baseDir = dirname(__DIR__);

// 1. PSR-4 Autoloader
if (file_exists($baseDir . '/vendor/autoload.php')) {
    require_once $baseDir . '/vendor/autoload.php';
} else {
    spl_autoload_register(function (string $class) use ($baseDir) {
        $installerDir = is_dir($baseDir . '/vendor/nexus-lab/cpanel-installer/src')
            ? $baseDir . '/vendor/nexus-lab/cpanel-installer/src/'
            : $baseDir . '/packages/cpanel-installer/src/';

        $prefixMap = [
            'Core\\'               => $baseDir . '/core/',
            'App\\'                => $baseDir . '/app/',
            'Components\\'         => $baseDir . '/components/',
            'Nexus\\Installer\\'   => $installerDir,
            'NextPHP\\Installer\\' => $installerDir,
        ];
        foreach ($prefixMap as $prefix => $base) {
            $len = strlen($prefix);
            if (strncmp($prefix, $class, $len) === 0) {
                $relative = substr($class, $len);
                $file = $base . str_replace('\\', '/', $relative) . '.php';
                if (file_exists($file)) {
                    require_once $file;
                    return;
                }
            }
        }
    });
}

// 2. Load Environment if .env exists
if (file_exists($baseDir . '/.env')) {
    \Core\Env::load($baseDir . '/.env');
}

// 3. Delegate execution to Core\Console\Cli
$exitCode = \Core\Console\Cli::run($argv, $baseDir);
exit($exitCode);
